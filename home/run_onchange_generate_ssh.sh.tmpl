#!/bin/sh

set -eu

ssh_dir="$HOME/.ssh"
{{- if .sign_git_commits }}
allowed_signers="$HOME/.config/git/allowed_signers"
{{- end }}

{{- if .generate_ssh_keys }}
personal_auth_key="$ssh_dir/github_personal_ed25519"
{{- if .business_enabled }}
business_auth_key="$ssh_dir/github_business_ed25519"
{{- end }}
{{- end }}
{{- if .sign_git_commits }}
personal_signing_key="$ssh_dir/github_personal_signing_ed25519"
{{- if .business_enabled }}
business_signing_key="$ssh_dir/github_business_signing_ed25519"
{{- end }}
{{- end }}

is_dry_run() {
    [ "${CHEZMOI_DRY_RUN:-}" = "true" ]
}

generate_key() {
    key_path=$1
    key_comment=$2
    key_purpose=$3

    if [ -f "$key_path" ]; then
        printf '%s key already exists: %s\n' "$key_purpose" "$key_path"
        return
    fi

    if is_dry_run; then
        printf 'Would generate %s key: %s\n' "$key_purpose" "$key_path"
        return
    fi

    printf 'Generating %s key: %s\n' "$key_purpose" "$key_path"
    printf 'ssh-keygen will ask for an optional passphrase.\n'
    ssh-keygen -t ed25519 -C "$key_comment" -f "$key_path"
}

{{- if .sign_git_commits }}
write_allowed_signers() {
    missing_keys=false

    if [ ! -f "${personal_signing_key}.pub" ]; then
        printf 'Missing signing public key: %s.pub\n' "$personal_signing_key" >&2
        missing_keys=true
    fi
{{- if .business_enabled }}
    if [ ! -f "${business_signing_key}.pub" ]; then
        printf 'Missing signing public key: %s.pub\n' "$business_signing_key" >&2
        missing_keys=true
    fi
{{- end }}

    if [ "$missing_keys" = true ]; then
        printf 'Skipping allowed_signers generation.\n' >&2
        return
    fi

    if is_dry_run; then
        printf 'Would write allowed signers: %s\n' "$allowed_signers"
        return
    fi

    mkdir -p "$(dirname "$allowed_signers")"
    {
        printf '%s %s\n' \
            {{ .personal_email | quote }} \
            "$(cat "${personal_signing_key}.pub")"
{{- if .business_enabled }}
        printf '%s %s\n' \
            {{ .business_email | quote }} \
            "$(cat "${business_signing_key}.pub")"
{{- end }}
    } > "$allowed_signers"
    chmod 600 "$allowed_signers"
}
{{- end }}

if is_dry_run; then
    printf 'Would ensure SSH directory exists: %s\n' "$ssh_dir"
else
    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"
fi

{{- if .generate_ssh_keys }}
generate_key \
    "$personal_auth_key" \
    {{ .personal_email | quote }} \
    "personal authentication"
{{- if .sign_git_commits }}
generate_key \
    "$personal_signing_key" \
    {{ .personal_email | quote }} \
    "personal signing"
{{- end }}

{{- if .business_enabled }}
generate_key \
    "$business_auth_key" \
    {{ .business_email | quote }} \
    "business authentication"
{{- if .sign_git_commits }}
generate_key \
    "$business_signing_key" \
    {{ .business_email | quote }} \
    "business signing"
{{- end }}
{{- end }}
{{- else }}
printf 'Automatic SSH key generation is disabled.\n'
{{- end }}

{{- if .sign_git_commits }}
write_allowed_signers
{{- end }}

printf '%s\n' 'SSH key setup completed.'
printf '%s\n' 'Register authentication and signing public keys with GitHub as needed.'
